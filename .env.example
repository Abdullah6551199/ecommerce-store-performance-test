# ==============================================================================
# Environment Configuration Template
# Copy this file to .env.local for local development
# Do NOT commit sensitive production credentials to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Cloudflare Credentials & D1 Database
# ------------------------------------------------------------------------------
# API Token with D1 and Workers permissions
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=c9359eb2-a5dc-4eff-98f9-bac8118cb3dd
DATABASE_URL=

# ------------------------------------------------------------------------------
# Cloudflare R2 Storage Credentials (S3-compatible)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=ecommerce-store-assets
R2_PUBLIC_URL=https://assets.yourstore.com

# ------------------------------------------------------------------------------
# Security & JWT Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
SESSION_SECRET=your_session_secret_key
ADMIN_SECRET=your_admin_secret_key

# ------------------------------------------------------------------------------
# Google OAuth Configuration
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
