    {
      "id": "tech-footer",
      "type": "footer",
      "variant": "standard",
      "enabled": true,
      "settings": {
        "logo_text": "NEXUS // TECH",
        "copyright": "© 2026 Nexus Hardware Labs Inc."
      }
    }
